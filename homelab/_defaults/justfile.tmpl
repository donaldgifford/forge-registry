# ${project_name} — run `just` for the menu.

default:
    @just --list

# Lint markdown + yaml
lint:
    yamllint .
    markdownlint-cli2 '**/*.md'
    prettier --check '**/*.md'

# Auto-fix lint issues
fmt:
    yamlfmt .
    prettier --write '**/*.md'

# Sync labels to ${git_provider.host} via gitea-label-sync
labels-sync:
