---
name: lint
on:
  pull_request:
  push:
    branches: [main]

concurrency:
  group: lint-$${{ github.workflow }}-$${{ github.ref }}
  cancel-in-progress: true

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: jdx/mise-action@v2
      - run: just lint
