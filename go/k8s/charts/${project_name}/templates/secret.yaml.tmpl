{{- if and .Values.secrets.create .Values.secrets.stringData -}}
apiVersion: v1
kind: Secret
metadata:
  name: {{ include "${project_name}.fullname" . }}
  namespace: {{ .Release.Namespace }}
  labels:
    {{- include "${project_name}.labels" . | nindent 4 }}
type: Opaque
stringData:
  {{- range $key, $value := .Values.secrets.stringData }}
  {{ $key }}: {{ $value | quote }}
  {{- end }}
{{- end }}
